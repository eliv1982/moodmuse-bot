# Telegram (required)
BOT_TOKEN=your_telegram_bot_token_here

# Logging: INFO, DEBUG, ...
# LOG_JSON=false — readable plain-text logs for local development
# LOG_JSON=true  — structured JSON logs (future Grafana Loki / observability)
# LOG_LEVEL=INFO
# LOG_JSON=false

# SQLite and limits
# DATA_DIR=data
# DAILY_GENERATION_LIMIT=5
# MAX_CAPTION_LENGTH=1024

# Private access (REQUIRED to use the bot): comma-separated numeric Telegram user ids.
# Only these users can use the bot at all; everyone else just gets an "invite-only" notice.
# Missing, empty or malformed => nobody is allowed (fails closed). Restart the bot after changing it.
# Admins are NOT allowed implicitly: an admin must be listed here too.
# Find your own id: message the bot once and read the `access_denied user_id=...` line in its log.
# ALLOWED_USER_IDS=<owner_telegram_id>,<second_user_telegram_id>

# Admin user IDs (comma-separated Telegram numeric ids) — admin commands and limit exemption only
# ADMIN_USER_IDS=123456789,987654321

# OpenAI direct API (default for text, images and voice): one key covers all three.
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Image provider: openai (default, direct OpenAI Images API) or proxi (legacy ProxyAPI.ru)
# IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high | auto. Empty omits the parameter. Sent only for gpt-image* models.
# OPENAI_IMAGE_QUALITY=medium
# Seconds. Image generation at medium quality can take well over a minute.
# OPENAI_IMAGE_TIMEOUT=180

# Text provider: openai (default) or yandex (legacy)
# TEXT_PROVIDER=openai
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=90

# Speech-to-text (default: OpenAI transcriptions; requires ffmpeg for Telegram voice .ogg)
# STT_PROVIDER=openai
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# STT_TIMEOUT=45
# FFMPEG_BINARY=ffmpeg
# Legacy ProxyAPI Whisper fallback:
# STT_PROVIDER=proxi
# STT_PROVIDER=proxiapi

# --- Legacy providers (only when selected explicitly; not needed with the defaults above) ---

# ProxyAPI.ru — images (IMAGE_PROVIDER=proxi); Whisper STT (STT_PROVIDER=proxi or proxiapi).
# The openai image quality setting is not sent on this route.
# IMAGE_PROVIDER=proxi
# PROXI_API_KEY=your_proxyapi_key
# PROXI_BASE_URL=https://openai.api.proxyapi.ru
# PROXI_IMAGE_MODEL=gpt-image-2.5-flare
# PROXI_IMAGE_TIMEOUT=120

# Yandex Cloud Foundation Models — text + prompt refinement (TEXT_PROVIDER=yandex)
# Create a folder, service account with ai.languageModels.user, API key in console.
# TEXT_PROVIDER=yandex
# YANDEX_API_KEY=your_yandex_api_key
# YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxxxxx
# YANDEX_MODEL_SUFFIX=yandexgpt/latest
# YANDEX_COMPLETION_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# YANDEX_TIMEOUT=90
# YANDEX_PROMPT_REFINE_TIMEOUT=45
